#!/bin/sh -e

set -x

# Python 3.8/3.9/3.10 cannot use `uv sync --frozen` (uv.lock is locked for
# >= 3.11), and several runtime dependencies have no PyPI release supporting
# 3.8/3.9. Install the py38deps backport wheels (same versions, widened
# `requires-python`) from the py38deps package index, then the project and the
# test dependencies explicitly. Linting and packaging are skipped for 3.8-3.10
# in CI.

# The index only adds the wheels that PyPI cannot provide for 3.8/3.9. uv must
# merge both indexes the way pip does (`unsafe-best-match`); the default
# `first-index` strategy stops at the first index that has the project and never
# sees the backport wheels.
export UV_EXTRA_INDEX_URL="https://py38deps.github.io/py38deps/simple/"
export UV_INDEX_STRATEGY="unsafe-best-match"

uv venv

# Runtime dependencies without a 3.8/3.9-compatible PyPI release. The specifiers
# mirror the ones in the two pyproject files.
#
# `--no-config`: the py38deps index is a static page without upload dates, and
# `exclude-newer` (7 days, from pyproject.toml) drops every candidate that has no
# upload date. The remaining steps resolve against PyPI, where it still applies.
uv pip install --no-config \
    "anyio>=4.10" \
    "truststore>=0.10" \
    "idna>=3.18" \
    "trio>=0.34.0,<1.0" \
    "wsproto>=1.2" \
    "h2>=3,<5" \
    "hyperframe" \
    "hpack"

uv pip install -e "src/httpcore2[asyncio,trio,http2,socks]" -e "src/httpx2[brotli,http2,socks,ws,zstd]"

# Test dependencies (versions compatible with 3.8/3.9/3.10).
# `brotlicffi` is pulled in by httpbin; pin 1.1.0.0 which ships wheels for 3.8.
uv pip install "brotlicffi==1.1.0.0"
uv pip install \
    "pytest>=8.3.5,<9" \
    "pytest-cov>=5,<6" \
    "pytest-xdist>=3.6.1,<4" \
    "pytest-trio==0.8.0" \
    "pytest-httpbin==2.1.0" \
    "flaky>=3.8" \
    "trustme==1.1.0" \
    "chardet==5.2.0" \
    "websockets>=13.1,<16" \
    "coverage[toml]==7.6.1"

# The httpx2 CLI extra (`click>=8.4.2`) requires Python >= 3.10; install the
# last 3.8-compatible click and its dependencies for the CLI tests.
uv pip install "click==8.1.8" "rich>=10,<16"

if [ "$(.venv/bin/python -c 'import sys; print(sys.version_info[1])')" = "8" ]; then
    # Python 3.8: uvicorn 0.33 is the last release supporting it (it lacks the
    # `websockets-sansio` implementation, added in 0.35); starlette and
    # cryptography are pinned to their last 3.8-compatible lines.
    uv pip install "starlette>=0.40,<0.41" "uvicorn>=0.33,<0.34" "cryptography>=44,<45"
elif [ "$(.venv/bin/python -c 'import sys; print(sys.version_info[1])')" = "9" ]; then
    # Python 3.9: upstream-compatible versions. pytest-codspeed (>= 3.9) is
    # needed here because the benchmark tests are only skipped on 3.8.
    uv pip install "starlette>=0.49,<1.0" "uvicorn>=0.35,<0.53" "cryptography>=49,<50"
    uv pip install "pytest-codspeed==3.2.0"
else
    # Python 3.10: the same versions the 3.11+ jobs get from uv.lock (starlette
    # 1.6 and uvicorn 0.52 require 3.10, websockets 16 is the first 3.10-only
    # line). pytest-codspeed (>= 3.9) is needed here because the benchmark tests
    # are only skipped on 3.8.
    uv pip install "starlette>=1.6,<2" "uvicorn>=0.52.4,<0.53" "cryptography>=50,<51"
    uv pip install "websockets>=16.1.1,<17"
    uv pip install "pytest-codspeed==5.0.3"
fi
